#!/bin/bash

# ## -------------------------------------------------------------------------------##
# HEADER        : we first specify what is required to be identified on the cluster
# CHANGES TO DO :
#           NAME_OF_THE_JOB             -> name of your job
#           firstname.name@lsce.ipsl.fr -> your email @lsce

# Specify the job's name (<= 15 letters)
#PBS -N TEST_JOBBY
# Specify batch queue
#PBS -q long
# Reserve 1 node with 1 core
#PBS -l nodes=1:ppn=1
# Request that stdin and stdout are merged in the same output file
#PBS -j eo
# Send a mail when the job terminates
#PBS -m e -M didier.roche@lsce.ipsl.fr
# Force the shell to be bash
#PBS -S /bin/bash

# ## -------------------------------------------------------------------------------##
# EXPERIMENT DEFINITION
# CHANGES TO DO :
#           nomexp       -> give a proper name to the experiment, without spaces or special chars
#           options      -> provide the options needed for your special run
#                           NOTA: do not provide -l, -t options here, they are dealt with below

nomexp="testJOBBY"
options="-n 500 -r 150 -k"

# ## -------------------------------------------------------------------------------##
# MODULES LOAD  : depends on your configuration
# CHANGES TO DO :
#           set the env_compiler variable to -> 0 | intel or 1 | gcc
#           set the git_version variable  to -> 0 | svn   or 1 | git

. $MODULESHOME/init/bash
module purge

env_compiler=0
git_version=1


# ## ---------------- DO NOT CHANGE ANYTHING BELOW THIS LINE ------------------##

if [[ "${env_compiler}" -eq 1 ]]; then
    echo "Loading gcc compiler environnement"
    module load netcdf/4.9.2-gcc14-acc
    module load gcc/14.2.0-openacc
elif [[ "${env_compiler}" -eq 0 ]]; then
    echo "Loading intel compiler environnement"
    module load hdf5/1.10.5
    module load netcdf/4.7
    module load intel-fcomp/2020
fi

if [[ "${git_version}" -eq 1 ]]; then
    run_command="./run-me.sh"
elif [[ "${env_compiler}" -eq 0 ]]; then
    run_command="./bin/run-iloveclim"
fi

# ## -------------------------------------------------------------------------------##

# Let's get started with setting up the paths
origin_path="${PBS_O_WORKDIR}"
cd "${origin_path}"

# ## -------------------------------------------------------------------------------##
# SCRATCH SPACE
# The scratch path depends on the cluster and is NOT always exposed under the same
# variable name. It is known here (in the job) but not by run-me.sh, so we resolve
# it here and pass it explicitly via -t. On obelix, $WORKDIR is the scratch space.
# Adapt the resolution below to your cluster. We deliberately do NOT fall back to
# /tmp: run-me.sh refuses a /tmp scratch (drain purges the source, so /tmp would be
# dangerous), and a silent /tmp fallback hides a misconfigured environment.
scratch="${WORKDIR:-${SCRATCHDIR}}"

if [ -z "${scratch}" ] || [ ! -d "${scratch}" ]; then
    echo "[JOB] ERROR: scratch directory not set or missing (WORKDIR/SCRATCHDIR): '${scratch}'"
    echo "[JOB]        Set the correct scratch variable for this cluster above."
    exit 1
fi
echo "[JOB] Using scratch directory: ${scratch}"

# This allows to retrieve the machine name, useful in case of problems
uname -a

# Setting reference time for experiment start
echo "[START] date"
date

# ## -------------------------------------------------------------------------------##
# Launch iLOVECLIM.
#   - setup + compilation are done on emic_dir (login/submission side)
#   - the run itself is executed on the scratch dir passed via -t
#   - with -D, results are drained from scratch to emic_dir WHILE running, freeing
#     scratch space as large time-sliced files fall quiescent
#   - results end up in emic_dir/wkdir/<exp>/run/outputdata<start_year> (sealed on
#     success). No copy to data/ anymore.
# run-me.sh is synchronous and handles draining/retrieval/sealing itself: no
# background job, no PID watching, no manual rsync loop needed here.
#
# Optional tuning via environment (defaults shown):
#   DRAIN_INTERVAL=3600   seconds between drain passes
#   DRAIN_QUIESCE=30      minutes of immobility before a large file is purged
#   DRAIN_MINSIZE=$((500*1024*1024))  bytes: min size to purge from scratch
#   DRAIN_CKSUM=0         set to 1 to checksum-verify before purging (slower)
${run_command} -l "${nomexp}" ${options} -t "${scratch}" -D > "${nomexp}.twt" 2>&1

status=$?

date
if [ ${status} -eq 0 ]; then
    echo "[END] Results sealed in wkdir/${nomexp}_ecbilt_clio/run/"
else
    echo "[END] run-me.sh exited with status ${status}. Check ${nomexp}.twt"
    echo "[END] If the run itself failed, unsealed outputs are in"
    echo "[END]   wkdir/${nomexp}_ecbilt_clio/run/outputdata (diagnostic dump)."
fi

exit ${status}

# The End of All Things (op. cit.)
